generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Managed at runtime by connect-pg-simple (createTableIfMissing), declared here only
/// so Prisma's migration diffing doesn't try to drop it. Never queried via Prisma Client.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum RoleKey {
  admin
  grande_compagnie
  sous_traitant
  inspecteur
  travailleur
  chef_equipe
  comptable
  mecanicien
  developpeur
}

enum OrganizationType {
  grande_compagnie
  sous_traitant
}

enum TaskStatus {
  open
  claimed
  in_progress
  completed
  inspected
  cancelled
}

enum InvoiceStatus {
  unpaid
  paid
  overdue
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum PhotoType {
  before
  after
}

enum EarningStatus {
  pending
  disputed
  available
  withdrawn
}

enum WithdrawalStatus {
  pending
  paid
  failed
}

/// Type d'écriture du grand livre (append-only, jamais modifié ni supprimé).
enum LedgerEntryType {
  gain_cree
  gain_dispo
  commission
  penalite
  prime
  transfert_clan
  retrait
  retrait_echoue
  abonnement
  charge_sous_traitant
  ajustement_inspecteur
}

enum InventoryItemKind {
  consommable
  produit_chimique
  gaz
  machine
}

/// Comment une tâche est payée. `fixed` = comportement historique (montant = price).
/// `metric_prorata` = price × min(1, réalisé/cible). `hourly` = taux × temps réel.
/// `per_unit` = prix unitaire × nombre réalisé.
enum PaymentMode {
  fixed
  hourly
  per_unit
  metric_prorata
}

/// État d'un fil de négociation de prix (Lot 4). `open` = en discussion,
/// `accepted` fige le prix du Task et l'assigne au travailleur, `rejected`/
/// `cancelled` ferment le fil sans effet sur la tâche.
enum NegotiationStatus {
  open
  accepted
  rejected
  cancelled
}

model Role {
  id        Int        @id @default(autoincrement())
  key       RoleKey    @unique
  label     String
  userRoles UserRole[]
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String?   @map("password_hash")
  fullName             String?   @map("full_name")
  phone                String?
  address              String?
  avatarKey            String?   @map("avatar_key")
  availability         Json?
  adminNote            String?   @map("admin_note")
  isActive             Boolean   @default(true) @map("is_active")
  stripeAccountId      String?   @map("stripe_account_id")
  stripeOnboardingDone Boolean   @default(false) @map("stripe_onboarding_done")
  termsAcceptedAt      DateTime? @map("terms_accepted_at")
  termsVersion         String?   @map("terms_version")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  roles                UserRole[]
  inspectedStores      StoreInspector[]
  assignedStores       Store[]              @relation("StoreAssignedWorker")
  createdStores        Store[]              @relation("StoreCreatedBy")
  assignedTasks        Task[]               @relation("TaskAssignedTo")
  createdTasks         Task[]               @relation("TaskCreatedBy")
  storeNotes           StoreNote[]
  uploadedDocuments    StoreDocument[]
  storeClaimsRequested StoreClaim[]
  taskClaims           TaskClaim[]
  taskNegotiations     TaskNegotiation[]
  passwordResetTokens  PasswordResetToken[]
  workerEarnings       WorkerEarning[]
  withdrawals          Withdrawal[]
  feedbackEntries      Feedback[]
  pointEntries         PointEntry[]
  workerMoments        WorkerMoment[]
  foundedClans         Clan[]               @relation("ClanFounder")
  clanMemberships      ClanMember[]

  @@map("users")
}

model UserRole {
  userId         String  @map("user_id")
  roleId         Int     @map("role_id")
  organizationId String? @map("organization_id")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Organization {
  id                    String           @id @default(uuid())
  name                  String
  type                  OrganizationType
  contactName           String?          @map("contact_name")
  contactEmail          String?          @map("contact_email")
  contactPhone          String?          @map("contact_phone")
  address               String?
  stripeCustomerId      String?          @map("stripe_customer_id")
  stripePaymentMethodId String?          @map("stripe_payment_method_id")
  createdAt             DateTime         @default(now()) @map("created_at")

  userRoles               UserRole[]
  storesAsGrandeCompagnie Store[]         @relation("StoreGrandeCompagnie")
  storesAsSubcontractor   Store[]         @relation("StoreSubcontractor")
  storeClaims             StoreClaim[]
  workerEarnings          WorkerEarning[]

  @@map("organizations")
}

model Store {
  id                      String    @id @default(uuid())
  name                    String
  banner                  String?
  address                 String?
  city                    String?
  postalCode              String?   @map("postal_code")
  latitude                Decimal?  @db.Decimal(9, 6)
  longitude               Decimal?  @db.Decimal(9, 6)
  geofenceLat             Decimal?  @map("geofence_lat") @db.Decimal(9, 6)
  geofenceLng             Decimal?  @map("geofence_lng") @db.Decimal(9, 6)
  geofenceRadiusM         Int?      @map("geofence_radius_m")
  geofencePoints          Json?     @map("geofence_points")
  storeManagerName        String?   @map("store_manager_name")
  storeManagerPhone       String?   @map("store_manager_phone")
  storeManagerEmail       String?   @map("store_manager_email")
  squareFootage           Decimal?  @map("square_footage")
  surfaceType             String?   @map("surface_type")
  zones                   String[]
  cleaningFrequency       String?   @map("cleaning_frequency")
  cleaningSchedule        String?   @map("cleaning_schedule")
  contractStartDate       DateTime? @map("contract_start_date") @db.Date
  contractEndDate         DateTime? @map("contract_end_date") @db.Date
  contractRate            Decimal?  @map("contract_rate")
  securityAccessInfo      String?   @map("security_access_info")
  storeHours              String?   @map("store_hours")
  specialRequirements     String?   @map("special_requirements")
  grandeCompagnieId       String?   @map("grande_compagnie_id")
  assignedSubcontractorId String?   @map("assigned_subcontractor_id")
  assignedWorkerId        String?   @map("assigned_worker_id")
  isActive                Boolean   @default(true) @map("is_active")
  recurrencePaused        Boolean   @default(false) @map("recurrence_paused")
  createdById             String?   @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  grandeCompagnie       Organization?     @relation("StoreGrandeCompagnie", fields: [grandeCompagnieId], references: [id])
  assignedSubcontractor Organization?     @relation("StoreSubcontractor", fields: [assignedSubcontractorId], references: [id])
  assignedWorker        User?             @relation("StoreAssignedWorker", fields: [assignedWorkerId], references: [id])
  createdBy             User?             @relation("StoreCreatedBy", fields: [createdById], references: [id])
  inspectors            StoreInspector[]
  tasks                 Task[]
  inventoryItems        StoreInventoryItem[]
  contacts              StoreContact[]
  notes                 StoreNote[]
  documents             StoreDocument[]
  invoices              StoreInvoice[]
  claims                StoreClaim[]
  inspections           StoreInspection[]

  @@index([name])
  @@index([isActive])
  // "Available stores" (assignedSubcontractorId IS NULL) is polled by every
  // subcontractor; the subcontractor task list filters by this too.
  @@index([assignedSubcontractorId])
  @@map("stores")
}

model StoreInspector {
  storeId String @map("store_id")
  userId  String @map("user_id")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
  @@map("store_inspectors")
}

model Task {
  id                       String     @id @default(uuid())
  storeId                  String     @map("store_id")
  description              String
  taskType                 String?    @map("task_type")
  price                    Decimal
  isNegotiable             Boolean    @default(false) @map("is_negotiable")
  isPublished              Boolean    @default(false) @map("is_published")
  visibleFrom              DateTime?  @map("visible_from")
  latePremiumApplied       Boolean    @default(false) @map("late_premium_applied")
  dueDate                  DateTime?  @map("due_date") @db.Date
  status                   TaskStatus @default(open)
  assignedToId             String?    @map("assigned_to")
  workerNote               String?    @map("worker_note")
  expectedResultText       String?    @map("expected_result_text")
  howToText                String?    @map("how_to_text")
  requiredEquipment        String[]   @map("required_equipment")
  estimatedDurationMinutes Int?       @map("estimated_duration_minutes")
  startedAt                DateTime?  @map("started_at")
  startGeoNote             String?    @map("start_geo_note")
  isRecurring              Boolean    @default(false) @map("is_recurring")
  lastRecurredOn           DateTime?  @map("last_recurred_on") @db.Date
  recurrenceSkipDate       DateTime?  @map("recurrence_skip_date") @db.Date
  recurringParentId        String?    @map("recurring_parent_id")
  templateId               String?    @map("template_id")
  // Per-store performance target copied from the template, editable. When set,
  // the worker must report a value on completion and the earning is scaled
  // min(1, reported / target). See payments.service metricPayoutRatio.
  metricLabel              String?    @map("metric_label")
  metricUnit               String?    @map("metric_unit")
  metricTarget             Decimal?   @map("metric_target")
  reportedMetricValue      Decimal?   @map("reported_metric_value")
  metricValueSource        String?    @map("metric_value_source")
  paymentMode              PaymentMode @default(fixed) @map("payment_mode")
  hourlyRate               Decimal?   @map("hourly_rate")
  hourlyCapMinutes         Int?       @map("hourly_cap_minutes")
  unitPrice                Decimal?   @map("unit_price")
  unitLabel                String?    @map("unit_label")
  reportedUnits            Decimal?   @map("reported_units")
  workedMinutes            Int?       @map("worked_minutes")
  requiresOdometer         Boolean    @default(false) @map("requires_odometer")
  startOdometer            Decimal?   @map("start_odometer")
  endOdometer              Decimal?   @map("end_odometer")
  startPhotoKey            String?    @map("start_photo_key")
  endPhotoKey              String?    @map("end_photo_key")
  category                 String?
  timeWindowStart          String?    @map("time_window_start")
  timeWindowEnd            String?    @map("time_window_end")
  requiresStartPhoto       Boolean    @default(false) @map("requires_start_photo")
  requiresEndPhoto         Boolean    @default(false) @map("requires_end_photo")
  recurrence               Json?
  variantName              String?    @map("variant_name")
  consumables              Json?
  reservableBy             String     @default("solo") @map("reservable_by")
  minClanSize              Int?       @map("min_clan_size")
  reservedByClanId         String?    @map("reserved_by_clan_id")
  createdById              String?    @map("created_by")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assignedTo     User?               @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy      User?               @relation("TaskCreatedBy", fields: [createdById], references: [id])
  template       TaskTemplate?       @relation(fields: [templateId], references: [id])
  recurringParent    Task?  @relation("TaskRecurrence", fields: [recurringParentId], references: [id], onDelete: SetNull)
  recurringInstances Task[] @relation("TaskRecurrence")
  reservedByClan     Clan?  @relation("ClanReservedTasks", fields: [reservedByClanId], references: [id], onDelete: SetNull)
  ledgerEntries      LedgerEntry[]
  inventoryMovements InventoryMovement[]
  negotiations       TaskNegotiation[]
  claims         TaskClaim[]
  inspection     TaskInspection?
  expectedPhotos TaskExpectedPhoto[]
  steps          TaskStep[]
  earning        WorkerEarning?
  pointEntries   PointEntry[]
  workerMoments  WorkerMoment[]

  @@index([storeId])
  // Marketplace list filters status = 'open' AND is_published = true; prefix
  // queries on status alone still use this composite.
  @@index([status, isPublished])
  // Worker's own task list, plus inspection/leaderboard joins, filter on assignedTo.
  @@index([assignedToId])
  @@index([recurringParentId])
  @@map("tasks")
}

/// Reusable task blueprint ("Polissage", "Balayage"…). Applying one to a store
/// copies its fields into a fresh unpublished Task (one-time copy, no live link).
model TaskTemplate {
  id                       String   @id @default(uuid())
  name                     String   @unique
  description              String
  taskType                 String?  @map("task_type")
  defaultPrice             Decimal? @map("default_price")
  isNegotiable             Boolean  @default(false) @map("is_negotiable")
  isRecurringDefault       Boolean  @default(false) @map("is_recurring_default")
  expectedResultText       String?  @map("expected_result_text")
  howToText                String?  @map("how_to_text")
  requiredEquipment        String[] @map("required_equipment")
  estimatedDurationMinutes Int?     @map("estimated_duration_minutes")
  metricLabel              String?  @map("metric_label")
  metricUnit               String?  @map("metric_unit")
  defaultMetricTarget      Decimal? @map("default_metric_target")
  paymentMode              PaymentMode @default(fixed) @map("payment_mode")
  hourlyRate               Decimal? @map("hourly_rate")
  hourlyCapMinutes         Int?     @map("hourly_cap_minutes")
  unitPrice                Decimal? @map("unit_price")
  unitLabel                String?  @map("unit_label")
  requiresOdometer         Boolean  @default(false) @map("requires_odometer")
  category                 String?
  timeWindowStart          String?  @map("time_window_start")
  timeWindowEnd            String?  @map("time_window_end")
  requiresStartPhoto       Boolean  @default(false) @map("requires_start_photo")
  requiresEndPhoto         Boolean  @default(false) @map("requires_end_photo")
  recurrence               Json?
  consumables              Json?
  reservableBy             String   @default("solo") @map("reservable_by")
  minClanSize              Int?     @map("min_clan_size")
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  steps    TaskTemplateStep[]
  variants TaskTemplateVariant[]
  tasks    Task[]

  @@index([isActive])
  @@map("task_templates")
}

model TaskTemplateStep {
  id         String @id @default(uuid())
  templateId String @map("template_id")
  order      Int
  text       String

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("task_template_steps")
}

/// Variante d'un modèle (« petit » / « grand »…). Surcharge le prix, la cible
/// métrique et/ou la durée. On choisit la variante en appliquant le modèle à
/// un magasin ; ses valeurs sont copiées dans la tâche (pas de lien vivant).
model TaskTemplateVariant {
  id              String   @id @default(uuid())
  templateId      String   @map("template_id")
  name            String
  price           Decimal?
  metricTarget    Decimal? @map("metric_target")
  durationMinutes Int?     @map("duration_minutes")
  order           Int      @default(0)

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("task_template_variants")
}

model TaskExpectedPhoto {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  fileName  String   @map("file_name")
  fileKey   String   @map("file_key")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_expected_photos")
}

model TaskStep {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  order     Int
  text      String
  isDone    Boolean  @default(false) @map("is_done")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_steps")
}

model StoreContact {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  role      String?
  phone     String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_contacts")
}

model StoreNote {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  authorId  String?  @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  store  Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])

  @@index([storeId])
  @@map("store_notes")
}

model StoreDocument {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  fileName     String   @map("file_name")
  fileKey      String   @map("file_key")
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  uploadedById String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([storeId])
  @@map("store_documents")
}

model StoreInvoice {
  id          String        @id @default(uuid())
  storeId     String        @map("store_id")
  label       String
  amount      Decimal
  status      InvoiceStatus @default(unpaid)
  issuedDate  DateTime?     @map("issued_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  paidDate    DateTime?     @map("paid_date") @db.Date
  createdById String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_invoices")
}

model StoreClaim {
  id                String      @id @default(uuid())
  storeId           String      @map("store_id")
  organizationId    String      @map("organization_id")
  requestedById     String      @map("requested_by")
  status            ClaimStatus @default(pending)
  note              String?
  decisionReason    String?     @map("decision_reason")
  seenByRequesterAt DateTime?   @map("seen_by_requester_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  decidedAt         DateTime?   @map("decided_at")

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  requestedBy  User         @relation(fields: [requestedById], references: [id])

  @@index([storeId])
  @@index([status])
  @@map("store_claims")
}

model TaskClaim {
  id                String      @id @default(uuid())
  taskId            String      @map("task_id")
  workerId          String      @map("worker_id")
  status            ClaimStatus @default(pending)
  note              String?
  decisionReason    String?     @map("decision_reason")
  seenByRequesterAt DateTime?   @map("seen_by_requester_at")
  clanId            String?     @map("clan_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  decidedAt         DateTime?   @map("decided_at")

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker User  @relation(fields: [workerId], references: [id])
  clan   Clan? @relation(fields: [clanId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([status])
  @@index([clanId])
  // "My claims", the claim-decision notification poll, and the per-store weekly
  // claim-count all filter on workerId; createdAt second serves the time range.
  @@index([workerId, createdAt])
  @@map("task_claims")
}

model TaskInspection {
  id                   String   @id @default(uuid())
  taskId               String   @unique @map("task_id")
  score                Int
  notes                String?
  /// Inspector's correction of the worker-reported metric value; recomputes the earning.
  correctedMetricValue Decimal? @map("corrected_metric_value")
  createdById          String?  @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")

  task   Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  photos TaskInspectionPhoto[]

  @@map("task_inspections")
}

model TaskInspectionPhoto {
  id           String    @id @default(uuid())
  inspectionId String    @map("inspection_id")
  fileName     String    @map("file_name")
  fileKey      String    @map("file_key")
  photoType    PhotoType @map("photo_type")
  createdAt    DateTime  @default(now()) @map("created_at")

  inspection TaskInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("task_inspection_photos")
}

model StoreInspection {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  score       Int
  notes       String?
  checklist   Json
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  store  Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  photos StoreInspectionPhoto[]

  @@index([storeId])
  @@map("store_inspections")
}

model StoreInspectionPhoto {
  id           String    @id @default(uuid())
  inspectionId String    @map("inspection_id")
  fileName     String    @map("file_name")
  fileKey      String    @map("file_key")
  photoType    PhotoType @map("photo_type")
  createdAt    DateTime  @default(now()) @map("created_at")

  inspection StoreInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("store_inspection_photos")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  role      String?
  selector  String
  context   String
  section   String
  note      String
  isMulti   Boolean  @default(false) @map("is_multi")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("feedback_entries")
}

/// Product-analytics events (page views, funnel steps, server milestones).
/// userId is a plain string, not a relation: events outlive the user and a
/// delete must not cascade them away. Internal use only — never shown to a
/// worker or their sous-traitant.
model AnalyticsEvent {
  id        String   @id @default(uuid())
  name      String
  userId    String?  @map("user_id")
  role      String?
  sessionId String?  @map("session_id")
  path      String?
  props     Json?
  source    String   @default("client")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([name, createdAt])
  @@index([sessionId])
  @@map("analytics_events")
}

model PointEntry {
  id        String   @id @default(uuid())
  workerId  String   @map("worker_id")
  taskId    String?  @map("task_id")
  kind      String
  points    Int
  createdAt DateTime @default(now()) @map("created_at")

  worker User  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workerId, createdAt])
  @@map("point_entries")
}

model WorkerMoment {
  id            String    @id @default(uuid())
  workerId      String    @map("worker_id")
  taskId        String?   @map("task_id")
  type          String
  title         String
  body          String
  pointsAwarded Int       @default(0) @map("points_awarded")
  meta          Json?
  seenAt        DateTime? @map("seen_at")
  emailedAt     DateTime? @map("emailed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  worker User  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workerId, seenAt])
  @@index([workerId, createdAt])
  @@map("worker_moments")
}

model PlatformSettings {
  id                    String   @id @default("singleton")
  commissionRatePercent Decimal  @default(5) @map("commission_rate_percent")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model WorkerEarning {
  id             String        @id @default(uuid())
  taskId         String        @unique @map("task_id")
  workerId       String        @map("worker_id")
  organizationId String        @map("organization_id")
  grossAmount    Decimal       @map("gross_amount")
  status         EarningStatus @default(pending)
  availableAt    DateTime      @map("available_at")
  chargeId       String?       @map("stripe_charge_id")
  withdrawalId   String?       @map("withdrawal_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  task         Task         @relation(fields: [taskId], references: [id])
  worker       User         @relation(fields: [workerId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  withdrawal   Withdrawal?  @relation(fields: [withdrawalId], references: [id])

  @@index([workerId, status])
  @@map("worker_earnings")
}

model Withdrawal {
  id               String           @id @default(uuid())
  workerId         String           @map("worker_id")
  grossAmount      Decimal          @map("gross_amount")
  commissionAmount Decimal          @map("commission_amount")
  netAmount        Decimal          @map("net_amount")
  status           WithdrawalStatus @default(pending)
  stripeTransferId String?          @map("stripe_transfer_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  worker   User            @relation(fields: [workerId], references: [id])
  earnings WorkerEarning[]

  @@map("withdrawals")
}

/// Journal d'audit de la Console de gestion : qui a fait quoi, quand.
/// Écrit uniquement pour les actions de gestion (create/update/delete/décision
/// sur magasins, utilisateurs, rôles, modèles, demandes, feedback, réglages,
/// finances) — pas les changements de statut de tâche côté travailleur.
/// Aucune FK vers User : une entrée survit à la suppression du compte acteur
/// (identité figée dans actorLabel). Append-only : jamais modifié, jamais purgé.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorLabel String?  @map("actor_label")
  action     String
  section    String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  summary    String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([section, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Clan = groupe de travailleurs autonomes qui se réunissent pour réserver des
/// tâches plus grosses et paralléliser. ≠ sous-traitant (pas de comptes gérés).
/// Un travailleur peut appartenir à plusieurs clans.
model Clan {
  id         String   @id @default(uuid())
  name       String
  founderId  String   @map("founder_id")
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at")

  founder       User         @relation("ClanFounder", fields: [founderId], references: [id])
  members       ClanMember[]
  invites       ClanInvite[]
  taskClaims    TaskClaim[]
  negotiations  TaskNegotiation[]
  reservedTasks Task[]       @relation("ClanReservedTasks")

  @@index([founderId])
  @@map("clans")
}

model ClanMember {
  clanId          String   @map("clan_id")
  userId          String   @map("user_id")
  joinedAt        DateTime @default(now()) @map("joined_at")
  /// Part par défaut proposée à ce membre quand il rejoint une tâche du clan (%).
  defaultSharePct Int?     @map("default_share_pct")

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clanId, userId])
  @@index([userId])
  @@map("clan_members")
}

model ClanInvite {
  id         String    @id @default(uuid())
  clanId     String    @map("clan_id")
  email      String
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([clanId])
  @@map("clan_invites")
}

/// Grand livre — append-only, jamais modifié ni supprimé (contrainte dure du
/// Lot 5 : l'argent et les dates ne se perdent jamais). partyA/partyB référencent
/// librement un User ou une Organization (partyXType le précise) : pas de FK,
/// pour ne jamais bloquer une écriture d'audit sur une contrainte référentielle.
model LedgerEntry {
  id         String          @id @default(uuid())
  type       LedgerEntryType
  amount     Decimal
  currency   String          @default("CAD")
  partyAId   String?         @map("party_a_id")
  partyAType String?         @map("party_a_type") // "user" | "organization"
  partyBId   String?         @map("party_b_id")
  partyBType String?         @map("party_b_type")
  taskId     String?         @map("task_id")
  reason     String?
  status     String          @default("posted")
  createdAt  DateTime        @default(now()) @map("created_at")

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([partyAId, createdAt])
  @@index([taskId])
  @@map("ledger_entries")
}

/// Article de stock d'un magasin. `machine` utilise les champs dédiés
/// (odometer/lastServiceAt/nextServiceAt/condition) ; les autres kinds les
/// laissent nuls. Pas de gestion de bons de commande (décision Q46).
model StoreInventoryItem {
  id            String            @id @default(uuid())
  storeId       String            @map("store_id")
  kind          InventoryItemKind
  name          String
  unit          String?
  quantity      Decimal           @default(0)
  lowThreshold  Decimal?          @map("low_threshold")
  expiryDate    DateTime?         @map("expiry_date") @db.Date
  odometer      Decimal?
  lastServiceAt DateTime?         @map("last_service_at") @db.Date
  nextServiceAt DateTime?         @map("next_service_at") @db.Date
  condition     String?
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([storeId])
  @@index([storeId, isActive])
  @@map("store_inventory_items")
}

/// Mouvement de stock, append-only (jamais modifié ni supprimé — une correction
/// s'écrit comme un nouveau mouvement, pas comme une édition du précédent).
model InventoryMovement {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  delta     Decimal
  reason    String
  taskId    String?  @map("task_id")
  actorId   String?  @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  item StoreInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  task Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([taskId])
  @@map("inventory_movements")
}

/// Fil de négociation de prix (Lot 4) — seulement sur les tâches marquées
/// `isNegotiable`. Un travailleur (ou clan) ouvre le fil avec une contre-offre,
/// l'admin/inspecteur répond ; l'historique des offres reste (append-only,
/// jamais réécrit). `accepted` fige le prix + assigne la tâche (voir
/// negotiations.service).
model TaskNegotiation {
  id        String            @id @default(uuid())
  taskId    String            @map("task_id")
  workerId  String            @map("worker_id")
  clanId    String?           @map("clan_id")
  status    NegotiationStatus @default(open)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker User   @relation(fields: [workerId], references: [id])
  clan   Clan?  @relation(fields: [clanId], references: [id], onDelete: SetNull)
  offers TaskNegotiationOffer[]

  @@index([taskId])
  @@index([workerId])
  @@map("task_negotiations")
}

/// Une offre ou contre-offre dans un fil — jamais modifiée ni supprimée après
/// coup, seule la table `offers` grandit (comme AuditLog/LedgerEntry).
model TaskNegotiationOffer {
  id            String   @id @default(uuid())
  negotiationId String   @map("negotiation_id")
  authorRole    String   @map("author_role") // "worker" | "admin"
  authorId      String?  @map("author_id")
  amount        Decimal
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  negotiation TaskNegotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@index([negotiationId])
  @@map("task_negotiation_offers")
}
