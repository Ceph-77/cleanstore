generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Managed at runtime by connect-pg-simple (createTableIfMissing), declared here only
/// so Prisma's migration diffing doesn't try to drop it. Never queried via Prisma Client.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum RoleKey {
  admin
  grande_compagnie
  sous_traitant
  inspecteur
  travailleur
}

enum OrganizationType {
  grande_compagnie
  sous_traitant
}

enum TaskStatus {
  open
  claimed
  completed
  inspected
  cancelled
}

enum InvoiceStatus {
  unpaid
  paid
  overdue
}

model Role {
  id        Int        @id @default(autoincrement())
  key       RoleKey    @unique
  label     String
  userRoles UserRole[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  fullName     String?  @map("full_name")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles              UserRole[]
  inspectedStores     StoreInspector[]
  assignedStores      Store[]          @relation("StoreAssignedWorker")
  createdStores       Store[]          @relation("StoreCreatedBy")
  assignedTasks       Task[]           @relation("TaskAssignedTo")
  createdTasks        Task[]           @relation("TaskCreatedBy")
  storeNotes          StoreNote[]
  uploadedDocuments   StoreDocument[]

  @@map("users")
}

model UserRole {
  userId         String        @map("user_id")
  roleId         Int           @map("role_id")
  organizationId String?       @map("organization_id")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Organization {
  id           String           @id @default(uuid())
  name         String
  type         OrganizationType
  contactName  String?          @map("contact_name")
  contactEmail String?          @map("contact_email")
  contactPhone String?          @map("contact_phone")
  address      String?
  createdAt    DateTime         @default(now()) @map("created_at")

  userRoles              UserRole[]
  storesAsGrandeCompagnie Store[]  @relation("StoreGrandeCompagnie")
  storesAsSubcontractor   Store[]  @relation("StoreSubcontractor")

  @@map("organizations")
}

model Store {
  id                       String    @id @default(uuid())
  name                     String
  banner                   String?
  address                  String?
  city                     String?
  postalCode               String?   @map("postal_code")
  latitude                 Decimal?  @db.Decimal(9, 6)
  longitude                Decimal?  @db.Decimal(9, 6)
  storeManagerName         String?   @map("store_manager_name")
  storeManagerPhone        String?   @map("store_manager_phone")
  storeManagerEmail        String?   @map("store_manager_email")
  squareFootage            Decimal?  @map("square_footage")
  surfaceType              String?   @map("surface_type")
  zones                    String[]
  cleaningFrequency        String?   @map("cleaning_frequency")
  cleaningSchedule         String?   @map("cleaning_schedule")
  contractStartDate        DateTime? @map("contract_start_date") @db.Date
  contractEndDate          DateTime? @map("contract_end_date") @db.Date
  contractRate             Decimal?  @map("contract_rate")
  securityAccessInfo       String?   @map("security_access_info")
  storeHours               String?   @map("store_hours")
  specialRequirements      String?   @map("special_requirements")
  grandeCompagnieId        String?   @map("grande_compagnie_id")
  assignedSubcontractorId  String?   @map("assigned_subcontractor_id")
  assignedWorkerId         String?   @map("assigned_worker_id")
  isActive                 Boolean   @default(true) @map("is_active")
  createdById              String?   @map("created_by")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  grandeCompagnie       Organization?    @relation("StoreGrandeCompagnie", fields: [grandeCompagnieId], references: [id])
  assignedSubcontractor Organization?    @relation("StoreSubcontractor", fields: [assignedSubcontractorId], references: [id])
  assignedWorker        User?            @relation("StoreAssignedWorker", fields: [assignedWorkerId], references: [id])
  createdBy             User?            @relation("StoreCreatedBy", fields: [createdById], references: [id])
  inspectors            StoreInspector[]
  tasks                 Task[]
  contacts              StoreContact[]
  notes                 StoreNote[]
  documents             StoreDocument[]
  invoices              StoreInvoice[]

  @@index([name])
  @@index([isActive])
  @@map("stores")
}

model StoreInspector {
  storeId String @map("store_id")
  userId  String @map("user_id")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
  @@map("store_inspectors")
}

model Task {
  id           String     @id @default(uuid())
  storeId      String     @map("store_id")
  description  String
  taskType     String?    @map("task_type")
  price        Decimal
  isNegotiable Boolean    @default(false) @map("is_negotiable")
  dueDate      DateTime?  @map("due_date") @db.Date
  status       TaskStatus @default(open)
  assignedToId String?    @map("assigned_to")
  createdById  String?    @map("created_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy  User? @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([storeId])
  @@index([status])
  @@map("tasks")
}

model StoreContact {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  role      String?
  phone     String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_contacts")
}

model StoreNote {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  authorId  String?  @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  store  Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])

  @@index([storeId])
  @@map("store_notes")
}

model StoreDocument {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  fileName     String   @map("file_name")
  fileKey      String   @map("file_key")
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  uploadedById String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([storeId])
  @@map("store_documents")
}

model StoreInvoice {
  id          String        @id @default(uuid())
  storeId     String        @map("store_id")
  label       String
  amount      Decimal
  status      InvoiceStatus @default(unpaid)
  issuedDate  DateTime?     @map("issued_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  paidDate    DateTime?     @map("paid_date") @db.Date
  createdById String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_invoices")
}
