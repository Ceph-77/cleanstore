# Local dev only. Production uses .env.production (committed): https://api.kleanstor.org/api
VITE_API_URL=http://localhost:4000/api

# Stripe (cle publique, cote client) — optionnel, echoue proprement si absent
VITE_STRIPE_PUBLISHABLE_KEY=

# Sentry (monitoring) — optionnel. DSN publiable, va aussi dans .env.production.
VITE_SENTRY_DSN=
