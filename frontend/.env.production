# Loaded automatically by `vite build` (production mode), overrides .env.
# No secrets here — VITE_* values are baked into the public client bundle.
#
# CUTOVER: change this to https://api.kleanstor.org/api once that domain resolves
# (see DOMAIN-SETUP.md step 5). Leaving it on the Render URL keeps prod working
# until then. NOTE: a VITE_API_URL set in the Cloudflare build environment would
# override this file — remove it there so this file is the single source of truth.
VITE_API_URL=https://api.kleanstor.org/api
